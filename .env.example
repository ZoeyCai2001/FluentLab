# Project feature LLM configuration.
# Copy this file to .env and fill in the secret values locally.

KIMI_API_KEY=
KIMI_API_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding
PROJECT_LLM_PROVIDER=kimi
FLUENTLAB_DATA_PATH=backend/data/fluentlab_state.json
# Leave empty on same-origin deployments such as Vercel.
NEXT_PUBLIC_FLUENTLAB_API_URL=http://127.0.0.1:8001

# Optional shared-password gate for private use.
# Set these in production so only you and your friend can use the app.
FLUENTLAB_SHARED_PASSWORD=
FLUENTLAB_AUTH_TOKEN=
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
